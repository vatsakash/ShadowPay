// ═══════════════════════════════════════════════════════════════════════════
// Midnight Compact Smart Contract: ShadowPay
// Confidential Payroll & Revenue-Split Settlement Protocol
// Language: Minokawa / Compact (Midnight Network v0.23)
// ═══════════════════════════════════════════════════════════════════════════
// PRIVACY MODEL & CRYPTOGRAPHIC SPECIFICATION:
// 1. PUBLIC LEDGER STATE (on-chain, verifiable by any explorer/indexer):
//    - admin_pk: Public key of the organization administrator
//    - total_funded_budget: Public escrow deposit budget
//    - batch_hash: Cryptographic commitment root of the current payroll cycle
//    - authorized_auditor_hash: Hash commitment of the authorized auditor key
//    - recipient_count & claims_count: Public proof counters
//    - commitments: Map of verified shielded recipient commitment leaves
//    - spent_nullifiers: Persistent on-chain Map preventing double-claims
//    - is_settled: Public settlement status flag
//
// 2. PRIVATE WITNESSES (client-side only, NEVER disclosed or published):
//    - get_recipient_secret(): Private witness entropy known only to contributor
//    - get_salary_amount(): Individual private compensation amount (NEVER DISCLOSED)
//    - get_min_committed_amount(): Contractually guaranteed minimum floor
//    - get_batch_total_allocation(): Cumulative allocation sum proven in ZK
//    - compute_payout_nullifier(): Deterministic anti-double-claim nullifier
//    - verify_claim_witness(): Proves knowledge of (secret, salary) for commitment
//    - verify_auditor_key(): Authenticates auditor key against authorized_auditor_hash
//
// 3. ZERO-KNOWLEDGE CONSTRAINTS ENFORCED:
//    - Confidential Salary: salaryAmount is a private witness, never passed to disclose()
//    - Total Solvency: batch solvency proven in zero-knowledge: sum(splits) == total_funded_budget
//    - Contractual Minimums: salary >= minGuaranteedFloor verified inside circuit
//    - Anti-Double Claim: persistent spent_nullifiers map prevents replay attacks
//    - Authenticated Audits: only callers with valid auditKey matching auditor commitment can audit
// ═══════════════════════════════════════════════════════════════════════════
pragma language_version 0.23;

// Public Ledger State (Visible on Midnight Preprod Blockchain Explorer)
export ledger admin_pk: Bytes<32>;
export ledger total_funded_budget: Uint<64>;
export ledger batch_hash: Bytes<32>;
export ledger authorized_auditor_hash: Bytes<32>;
export ledger recipient_count: Counter;
export ledger claims_count: Counter;
export ledger is_settled: Boolean;

// Persistent on-chain registries for commitments and nullifier replay protection
export ledger commitments: Map<Bytes<32>, Boolean>;
export ledger spent_nullifiers: Map<Bytes<32>, Boolean>;

// Witness declarations for client-side zero-knowledge proof generation
witness get_recipient_secret(): Bytes<32>;
witness get_salary_amount(): Uint<64>;
witness get_min_committed_amount(): Uint<64>;
witness get_batch_total_allocation(): Uint<64>;
witness compute_payout_nullifier(secret: Bytes<32>, batchHash: Bytes<32>): Bytes<32>;
witness verify_claim_witness(secret: Bytes<32>, expectedCommitment: Bytes<32>, claimedAmount: Uint<64>): Boolean;
witness verify_auditor_key(key: Bytes<32>, expectedHash: Bytes<32>): Boolean;

// Circuit 1: Initialize Escrow & Deposit Payroll Budget
// Payer commits to a public funded budget, a batch root hash, and auditor auth commitment
export circuit deposit_payroll_budget(
    admin: Bytes<32>,
    budget: Uint<64>,
    batchHash: Bytes<32>,
    auditorHash: Bytes<32>
): [] {
    admin_pk = disclose(admin);
    total_funded_budget = disclose(budget);
    batch_hash = disclose(batchHash);
    authorized_auditor_hash = disclose(auditorHash);
    is_settled = false;
}

// Circuit 2: Commit Private Split Rule
// Proves in zero-knowledge that:
// (1) Recipient receives at least their contractually committed minimum (salary >= minGuaranteedFloor)
// (2) The commitment leaf binds the private secret and private salary
// (3) CRITICAL PRIVACY PROPERTY: salary is a private witness and is NEVER disclosed!
export circuit commit_recipient_split(
    recipientCommitment: Bytes<32>,
    minGuaranteedFloor: Uint<64>
): [] {
    // Constraint A: Settlement batch must still be accepting allocations
    assert(!is_settled, "Settlement batch is already finalized");

    // Constraint B: Commitment cannot be registered twice
    assert(!commitments.member(disclose(recipientCommitment)), "Commitment leaf already registered");

    // Constraint C: Private witnesses for salary and secret
    const salary = get_salary_amount();
    const secret = get_recipient_secret();

    // Constraint D: Contractual minimum floor verification inside the ZK circuit
    // Proves salary >= minGuaranteedFloor WITHOUT exposing the salary value on-chain
    assert(salary >= minGuaranteedFloor, "Recipient salary is below contractually committed minimum floor");

    // Constraint E: Verify commitment leaf integrity using private witness credentials
    const isValidCommitment = verify_claim_witness(secret, recipientCommitment, salary);
    assert(isValidCommitment, "Commitment leaf does not match private witness credentials");

    // Store the verified commitment leaf in on-chain ledger
    commitments.insert(disclose(recipientCommitment), true);
    recipient_count.increment(1);
}

// Circuit 3: Finalize Settlement Batch
// Generates a public zk-SNARK proof that:
// Total paid out across all shielded splits exactly matches the funded escrow budget.
// Notice: verified without revealing any individual compensation figure!
export circuit finalize_settlement_batch(): [] {
    assert(!is_settled, "Settlement batch is already finalized");
    
    // Total batch allocation is computed in zero-knowledge across all private leaves
    const totalAllocated = get_batch_total_allocation();
    assert(totalAllocated == total_funded_budget, "Sum of private splits must exactly equal total funded budget");
    
    is_settled = true;
}

// Circuit 4: Recipient Private Payout Claim
// Proves in zero-knowledge:
// (1) Contributor knows the private secret corresponding to their allocation commitment
// (2) Persistent on-chain nullifier check prevents double-claiming
// (3) Payout is unlocked without publicly revealing who claimed what amount
export circuit claim_private_payout(
    recipientCommitment: Bytes<32>,
    submittedNullifier: Bytes<32>
): [] {
    // Constraint A: Payouts can only be claimed once the batch is finalized and verified
    assert(is_settled, "Settlement batch must be finalized before claims can be processed");

    // Constraint B: Persistent on-chain nullifier check (Double-claim replay protection)
    assert(!spent_nullifiers.member(disclose(submittedNullifier)), "Nullifier already spent: double claim prevented");

    // Constraint C: Verify that the commitment exists in the registry
    assert(commitments.member(disclose(recipientCommitment)), "Recipient commitment not found in batch");

    // Constraint D: Private Witness verification (local client proof)
    const secret = get_recipient_secret();
    const claimedAmount = get_salary_amount();
    const isValidClaim = verify_claim_witness(secret, recipientCommitment, claimedAmount);
    assert(isValidClaim, "Invalid zero-knowledge entitlement witness proof");

    // Constraint E: Anti-double-claim nullifier derivation check
    const expectedNullifier = compute_payout_nullifier(secret, batch_hash);
    assert(expectedNullifier == submittedNullifier, "Nullifier mismatch: Invalid proof");

    // Constraint F: Persist spent nullifier on-chain to permanently block replay
    spent_nullifiers.insert(disclose(submittedNullifier), true);
    claims_count.increment(1);
}

// Circuit 5: Selective Disclosure for Tax & Compliance Auditing
// Allows an employee, DAO, or auditor with an authorized audit key to mathematically verify:
// - Full budget conservation (total funded == total allocated)
// - Total participants and settlement status
// STRICT ACCESS CONTROL: Only callers with a valid auditKey matching authorized_auditor_hash succeed.
export circuit disclose_payroll_audit(
    auditKey: Bytes<32>
): [Boolean, Uint<64>, Uint<64>] {
    // Authenticate auditor against on-chain authorization commitment
    const isAuthorized = verify_auditor_key(auditKey, authorized_auditor_hash);
    assert(isAuthorized, "Unauthorized auditor: invalid audit authorization key");

    const totalAllocated = get_batch_total_allocation();
    const isConserved = totalAllocated == total_funded_budget;
    return [
        disclose(isConserved),
        disclose(total_funded_budget),
        disclose(recipient_count.value())
    ];
}
